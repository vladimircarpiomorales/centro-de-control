# Copia este fichero a .env y ajusta lo que necesites. .env no se sube a git.

# ── Flask ──
SECRET_KEY=cambia-esto-por-algo-aleatorio
FLASK_PORT=7788
# Extensión de descargas cargada en Brave/Chrome (su ID en chrome://extensions)
EXTENSION_ID=

# ── IA ──
OLLAMA_URL=http://127.0.0.1:11434
# Router compatible con OpenAI (OmniRoute) para candidaturas, entrevistas y Whisper
OMNIROUTE_URL=http://127.0.0.1:20128/v1/chat/completions
OMNIROUTE_API_KEY=
CANDIDATURA_MODELO=kr/claude-sonnet-4.5
WHISPER_MODELO=groq/whisper-large-v3-turbo
# Voces de Piper (~/.local/share/piper)
INGLES_VOZ=en_US-lessac-medium
VOZ_ES=es_ES-davefx-medium

# ── Reactive Resume (puente logros → CV) ──
RESUME_URL=http://127.0.0.1:3004
RESUME_API_KEY=
RESUME_ID=

# ── Rutas de este equipo ──
COPIAS_DIR=~/OneDrive/MiPanelControl-copias
ESTUDIO_DIR=~/Proyectos/lpi-2026
AZ104_PROGRESO=~/Proyectos/az104-2026/progreso.json
CML_VMX=~/vmware/CML/cml.vmx
CML_URL=https://cml.local
# Discos a vigilar (separados por comas) y el de las VMs
DISCOS=/
VMS_DISCO=
# Carpeta donde vigilar copias «safeBackup» de OneDrive (vacío = no se mira)
SAFEBACKUP_DIR=
RUTA_OBSIDIAN_VAULT=~/Obsidian
PAPERLESS_MEDIA=~/paperless/media
PAPERLESS_CONSUME=~/paperless/consume
ONEDRIVEGUI_APPIMAGE=~/Downloads/OneDriveGUI.AppImage
